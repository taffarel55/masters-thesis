@article{wang_reliable_2025,
	title = {Reliable Collision Avoidance for Small {UAVs} via Deep Reinforcement Learning with Unified Data Representation},
	issn = {23013850},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105010408802&doi=10.1142%2fS2301385026500500&partnerID=40&md5=d045f59ab0cd7c0e2ba2e25870099a32},
	doi = {10.1142/S2301385026500500},
	abstract = {Collision avoidance is a fundamental capability for multi-{UAV} systems to complete autonomous tasks. For small rotary-wing {UAVs}, due to their limited perception capacities and flight endurance, achieving reliable collision avoidance remains challenging. To this end, we propose a reliable multi-{UAV} collision avoidance method based on deep reinforcement learning, which leverages information from neighboring {UAVs} to augment the onboard perception capabilities. This method utilizes a technique called unified data representation ({UDR}) to combine depth data from {LiDAR} measurements and information from neighboring {UAVs} into a compact feature embedding, which can effectively integrate various observations with significant dimensional differences and inconsistent environmental expressions. Based on this, the collision avoidance policy hosted by a neural network is learned and produces control references for each {UAV} to ensure safety during flight. The training experiments demonstrate that our method achieves approximately a 20\% improvement in average rewards compared to baseline approaches, using the same number of training episodes. Additionally, we perform validation experiments using the {PX}4 flight controller in a soft-in-the-loop ({SITL}) setup within the Gazebo simulator. Experimental results show that our approach significantly improves the reliability of collision avoidance, particularly in scenarios involving inter-aircraft collisions. © 2026 World Scientific Publishing Company.},
	journaltitle = {Unmanned Systems},
	author = {Wang, Guanzheng and Wang, Xiangke and Liu, Zhihong and Liu, Yunhao and Li, Xiaoxin},
	date = {2025},
	note = {Publisher: World Scientific
Type: Article},
	keywords = {Deep learning, Collision avoidance, Deep reinforcement learning, Optical radar, Unmanned aerial vehicles ({UAV}), Aircraft accidents, Collisions avoidance, Training aircraft, Fighter aircraft, Aircraft control, Autonomous task, Data representations, Flight control systems, Flight simulators, Multi {UAV}, Reinforcement learnings, Rotary wing, Small {UAV}, {UAV} systems, Unified data representation},
	annotation = {Cited by: 0},
}

@inproceedings{lee_low-swap_2019,
	title = {Low-swap eo sensor-based robust aircraft detection for daa technology in uas integration},
	isbn = {978-1-62410-589-0},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85084767668&doi=10.2514%2f6.2019-3049&partnerID=40&md5=a8c04e6d325da3a74f980cf170f16611},
	doi = {10.2514/6.2019-3049},
	abstract = {Detect-and-Avoid ({DAA}) technology is the key technique for {UAS} integration in the National Airspace System ({NAS}). To substitute radar for {DAA} purpose, Electro-Optical ({EO}) sensor-based aircraft detection method is proposed in this paper. The typical Low-Size, Weight, and Power (Low-{SWaP}) sensor, {EO} sensor, has many limitations but the proposed detection method helps robust detection of other aircraft. The main problem of {EO} sensor-based aircraft is short detection range and weather dependencies. However, the key problem of {EO} sensor has overcome to find moving obstacles not only for other aircraft because aircraft in the distance do not have aircraft shape and it looks small dot. Therefore, the main strategy of robust aircraft detection is detecting moving something using an optical-flow method as region-of-interest ({ROI}) for other aircraft. The suggested {ROI} is a big hint having high probabilities of aircraft detection. Deep learning-based aircraft detection could be implemented, at this step, to identify whether aircraft or not in the magnified {ROI} image. In this research, light-sport categorized aircraft, {CTLS} and Cessna, are used to get image data and flight information. Installation of onboard {EO} sensors obey the rule to cover ± 110 degrees following Detect-and-Avoid {MOPS}. In the conclusion, a robust aircraft detection method using {EO} sensors is proposed for safe {UAS} operation and tested in real flight test using {CTLS} and Cessna. © 2019 American Institute of Aeronautics and Astronautics. All rights reserved.},
	pages = {1 -- 8},
	booktitle = {{AIAA} Aviation 2019 Forum},
	publisher = {American Institute of Aeronautics and Astronautics Inc, {AIAA}},
	author = {Lee, Jaehyun and Lee, Hanseob and Shim, David Hyunchul},
	date = {2019},
	note = {Type: Conference paper},
	keywords = {Deep learning, Aircraft detection, Image segmentation, Detection methods, Unmanned aerial vehicles ({UAV}), Civil aviation, Detect and avoid, Electrooptical sensors, Flight information, National airspace system, Optical flow methods, Optical flows, Region of interest, Robust detection},
	annotation = {{AIAA} Aviation Forum and Exposition, Dallas, {TX}, {JUN} 17-21, 2019},
	annotation = {Cited by: 3; Conference name: {AIAA} Aviation 2019 Forum; Conference date: 17 June 2019 through 21 June 2019; Conference code: 228939},
	file = {PDF:/home/taffarel55/Zotero/storage/QVLMXNRB/Lee et al. - 2019 - Low-swap eo sensor-based robust aircraft detection for daa technology in uas integration.pdf:application/pdf},
}

