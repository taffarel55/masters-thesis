	keywords = {Costs, Hardware, Optical radar, Unmanned aerial vehicles ({UAV}), Autonomous obstacle avoidances, Depth perception, Hardware components, Low-cost sensors, Low-cost solution, Microcontrollers, Motion planning, Obstacle avoidance algorithms, quadcopter, Real time obstacle avoidance, Static obstacles},
	annotation = {Cited by: 5; Conference name: 7th {IEEE} Annual Computing and Communication Workshop and Conference, {CCWC} 2017; Conference date: 9 January 2017 through 11 January 2017; Conference code: 126721},
