	year = {2024},
	journal = {IEEE Transactions on Intelligent Transportation Systems},
	volume = {25},
	number = {7},
	pages = {6397 – 6426},
	doi = {10.1109/TITS.2024.3375893},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85189503062&doi=10.1109%2fTITS.2024.3375893&partnerID=40&md5=1afeb5b61496216a4c6907ceea8f7cc7},
	affiliations = {University Putra Malaysia, Faculty of Computer Science and Information Technology, Department of Communication Technology and Network, Serdang, 43400, Malaysia; Kabul Education University, Faculty of Computer Science, Department of Information Technology, Kabul, 1001, Afghanistan; Institute for Mathematical Research, University Putra Malaysia, Faculty of Computer Science and Information Technology, Department of Communication Technology and Network, Serdang, 43400, Malaysia},
	abstract = {In the contemporary landscape, the escalating deployment of drones across diverse industries has ushered in a consequential concern, including ensuring the security of drone operations. This concern extends to a spectrum of challenges, encompassing collisions with stationary and mobile obstacles and encounters with other drones. Moreover, the inherent limitations of drones, namely constraints on energy consumption, data storage capacity, and processing power, present formidable obstacles in developing collision avoidance algorithms. This review paper explores the challenges of ensuring safe drone operations, focusing on collision avoidance. We explore collision avoidance methods for UAVs from various perspectives, categorizing them into four main groups: obstacle detection and avoidance, collision avoidance algorithms, drone swarm, and path optimization. Additionally, our analysis delves into machine learning techniques, discusses metrics and simulation tools to validate collision avoidance systems, and delineates local and global algorithmic perspectives. Our evaluation reveals significant challenges in current drone collision prevention algorithms. Despite advancements, critical UAV network and communication challenges are often overlooked, prompting a reliance on simulation-based research due to cost and safety concerns. Challenges encompass precise detection of small and moving obstacles, minimizing path deviations at minimal cost, high machine learning and automation expenses, prohibitive costs of real testbeds, limited environmental comprehension, and security apprehensions. By addressing these key areas, future research can advance the field of drone collision avoidance and pave the way for safer and more efficient UAV operations.  © 2000-2011 IEEE.},
	author_keywords = {collision avoidance; drone collision; drone swarm; UAV navigation; Unmanned aerial vehicles (UAV)},
	keywords = {Air navigation; Aircraft accidents; Aircraft detection; Antennas; Artificial intelligence; Collision avoidance; Costs; Digital storage; Drones; Energy utilization; Learning systems; Obstacle detectors; Aerial vehicle; Collisions avoidance; Drone collision; Drone swarm; Europe; Regulation; Unmanned aerial vehicle; Unmanned aerial vehicle navigation; Vehicle navigation; Accident prevention},
	correspondence_address = {N.A.W.A. Hamid; Institute for Mathematical Research, University Putra Malaysia, Faculty of Computer Science and Information Technology, Department of Communication Technology and Network, Serdang, 43400, Malaysia; email: asila@upm.edu.my},
