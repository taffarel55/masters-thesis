@CONFERENCE{Leasure1993354,
	author = {Leasure, W.},
	title = {Collision Avoidance - State of the Art},
	year = {1993},
	journal = {Conference on Object-Oriented Programming Systems, Languages and Applications},
	pages = {354 – 360},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0027307788&partnerID=40&md5=dec35a52aae332ca9a360739071e447c},
	affiliations = {National Highway Traffic Safety, Administration, WA, United States},
	abstract = {Although crashes are rare events, nearly 40,000 individuals are killed in motor vehicle crashes annually in the US. Another 3 million are injured and the societal costs exceed $137 billion annually. These are unacceptable statistics that can only be significantly reduced by improving the collision avoidance capabilities of motor vehicles. The maturity of advanced technologies, many of them developed in the defense and aerospace sectors of the U.S. industry, provides the promise of a major breakthrough in assisting drivers in avoiding crashes. This paper identifies the opportunities for significant safety improvement based on analysis of accident data, assesses the potential for improvement through incorporation of IVHS technology into motor vehicles, describes the current state of development of such products, provides estimates an their cost and likely deployment schedule, and describes the National Highway Traffic Safety Administration's role in facilitating development and early deployment of cost-effective, user-friendly systems to assist drivers in avoiding crashes.},
	keywords = {Accident prevention; Cost accounting; Crashworthiness; Crash avoidance systems; Driver user-friendly systems; Intelligent vehicle highway systems (IVHS); State-of-the art collision avoidance; Automobile drivers},
	publisher = {Publ by ASCE},
	isbn = {0872629163},
	language = {English},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; Conference name: Proceedings of the Pacific Rim Trans Tech Conference; Conference date: 25 July 1993 through 28 July 1993; Conference code: 18898}
}

@ARTICLE{Pallavi202130761,
	author = {Pallavi, M. and Kumar, Pramod and Ali, Tanweer and Shenoy, Satish B.},
