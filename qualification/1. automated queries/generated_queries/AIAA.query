("collision avoidance" OR "detect and avoid" OR "detection and avoidance" OR "obstacle avoidance" OR "obstacle detection" OR "collision detection" OR "conflict resolution" OR "conflict avoidance" OR "conflict detection" OR "conflict identification" OR "conflict mitigation" OR "detection methods") AND (radar OR "radar signature" OR sar OR "synthetic aperture radar") AND ("artificial intelligence" OR "machine learning" OR "deep learning" OR AI OR ML OR DL OR "neural network") AND (UAV OR drone OR aircraft OR airplane OR aviation OR aerospace OR eVTOL OR "urban air mobility" OR UAM) NOT (camera OR vision OR visual OR "image-based" OR video OR marine OR maritime OR ship OR "multi-aircraft" OR "multi-UAV" OR "multi-drone" OR "multi-vehicle" OR "multi-agent" OR "drone swarm" OR swarm OR swarming OR "path planning")