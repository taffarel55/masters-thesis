	title = {Improving {GNSS} Reliability for Autonomous Vehicles by Detecting and Classifying Spoofing Attacks with Shallow Learning Models},
	isbn = {979-8-3503-5140-8},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85202352834&doi=10.1109%2fITC-Egypt61547.2024.10620541&partnerID=40&md5=78898c059d181d2088ebf6a26011e609},
	doi = {10.1109/ITC-Egypt61547.2024.10620541},
	abstract = {Spoofing attacks on the Global Navigation Satellite System ({GNSS}) present significant threats to the security and reliability of autonomous vehicle systems, vital in civilian and military operations. Spoofing involves manipulating a vehicle's navigation system with false {GNSS} signals, potentially causing it to deviate from its path or crash. This study uses supervised Machine Learning ({ML}) models to detect {GNSS} spoofing attacks. These models were developed and tested using a dataset of authentic {GNSS} signals collected from diverse locations. Additionally, three types of {GNSS} spoofing attacks-simple, intermediate, and advanced-were simulated to mimic real-world scenarios using specialized equipment. The results of our experiments demonstrate the effectiveness of supervised {ML} in detecting and mitigating {GNSS} spoofing attacks. Testing accuracy rates of approximately 99.2\% and 99.1\% were achieved for the Decision Tree ({DT}) and K-Nearest Neighbor ({KNN}) algorithms, respectively. These findings underscore the importance of our approach in enhancing the accuracy and reliability of {GNSS}-based location services for autonomous vehicles. This research offers valuable insights for improving {GNSS} implementations and lays the groundwork for future advancements in spoofing detection methods. © 2024 {IEEE}.},
	pages = {812 -- 817},
	booktitle = {2024 International Telecommunications Conference, {ITC}-Egypt 2024},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Ezzelarab, Mohamed A. and Abdelhalim, Eman and Mohamed, Mohamed A. and Abosekeen, Ashraf},
	date = {2024},
	note = {Type: Conference paper},
	keywords = {Synthetic aperture radar, Machine learning, Aircraft detection, Unmanned aerial vehicles ({UAV}), Aircraft accidents, Aerial vehicle, Machine-learning, Decision tree, Fighter aircraft, Global navigation satellite system, Global Navigation Satellite Systems, Global positioning system, K-near neighbor, Military helicopters, Military satellites, Nearest neighbor search, Nearest-neighbour, Self-supervised learning, Spoofing and unmanned aerial vehicle, Spoofing attacks, Supervised learning},
