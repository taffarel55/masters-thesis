	keywords = {Image enhancement, Dimensionality reduction, Drone detection using radar signal, Hybrid quantum neural network, Quantum Computing, Quantum electronics, Quantum neural networks, Radar returns, Radar signals, Return signals, Signal features, Time domain, Time domain analysis, Time domain features, drone detection using radar signals, hybrid quantum neural network, Quantum computing, time domain features},
	annotation = {Cited by: 1; All Open Access, Gold Open Access},
}

