	keywords = {Deep learning, Feature extraction, Object detection, Neural networks, Convolution, Clustering algorithms, Aircraft detection, Correlation, Object recognition, Computational efficiency, Hyperspectral imaging, Radar target recognition, detection method, Features extraction, Convolutional neural network, artificial neural network, Objects detection, Extraction, cluster analysis, Clusterings, Computational modelling, correlation, Correlation distance, Correlation distance constraint, Density peak clustering, Distance constraints, Hyperspectral target detection, Lightweight convolutional neural network, numerical model},
