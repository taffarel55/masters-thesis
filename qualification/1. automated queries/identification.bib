@article{wang_deep_2022,
	title = {Deep Learning-Based {UAV} Detection in Pulse-Doppler Radar},
	volume = {60},
	issn = {01962892},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85113301040&doi=10.1109%2fTGRS.2021.3104907&partnerID=40&md5=75d5b8cd4304a846590faa14f9452c32},
	doi = {10.1109/TGRS.2021.3104907},
	abstract = {With the popularity of unmanned aerial vehicles ({UAVs}), how to conduct automatic and effective detection to prevent unauthorized flying has become an important issue. The conventional constant false alarm rate ({CFAR}) detector based on radar signal has shown advantages in moving target detection. However, the {CFAR}-based detectors are strongly dependent on some manual experience, such as the ambient noise distribution estimation and the detection windows' size selection, and usually suffered poor performance on small {UAV} detection due to the weak signal. Inspired by the success of deep learning ({DL}) on natural scene object detection, this article tries to explore a {DL}-based method for {UAV} detection in pulse-Doppler radar. Concretely, we propose a convolutional neural network ({CNN}) with two heads: one for the classification of the input range-Doppler map patch into target present or target absent and the other for the regression of offset between the target and the patch center. Then, based on the output of the network, a nonmaximum suppression ({NMS}) mechanism composed of probability-based initial recognition, distribution density-based recognition, and voting-based regression is developed to reduce false alarms as well as control the false alarms. Finally, experiments on both simulated data and real data are carried out, and it is shown that the proposed method can locate the target more accurately and achieve a much lower false alarm rate at a comparable detection rate than {CFAR}. © 1980-2012 {IEEE}.},
	journaltitle = {{IEEE} Transactions on Geoscience and Remote Sensing},
	author = {Wang, Chenxing and Tian, Jiangmin and Cao, Jiuwen and Wang, Xiaohong},
