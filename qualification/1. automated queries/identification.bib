@inproceedings{wu_design_2022,
	location = {New York, {NY}, {USA}},
	title = {Design of Obstacle Location System},
	isbn = {978-1-4503-8432-2},
	url = {https://doi.org/10.1145/3501409.3501446},
	doi = {10.1145/3501409.3501446},
	series = {{EITCE} '21},
	abstract = {With the increasing number of cars in modern society, the number of traffic accidents also increases, and the car anti-collision system can assist people to drive safely. Aiming at the problem that the current anti-collision system can not predict the transverse distance s between the vehicle body and the obstacles, which may lead to scratch. An obstacle location system based on ranging measurement and angle measurement is proposed. The horizontal distance between the vehicle and the obstacle can be determined to reduce the possibility of scratch. The specific method is to measure the distance between the vehicle and the obstacle by improving the auto-correlation algorithm, and to obtain the lateral distance s between the vehicle and the obstacle by using {MUSIC} algorithm to measure the angle between the vehicle and the obstacle, the Distance d between the obstacle and the side of the vehicle is obtained, and the distance d is judged, thus the function of preventing scratch is realized. The simulation results show that the system can effectively locate the distance and angle of the obstacle.},
