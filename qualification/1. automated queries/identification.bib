@article{sun_method_2024,
	title = {A Method for Detecting Small Slow Targets on Sea Surface Based on {FC}-{MCNN}},
	volume = {12},
	issn = {2169-3536},
	doi = {10.1109/ACCESS.2024.3358684},
	abstract = {Detecting small slow targets on sea surface has always been a hot topic in radar target detection. Classical target detection methods based on single input mode are particularly prone to losing the phase information of the radar echo signal, which affects the detection performance of the radar. To solve the problem of phase information loss, a False alarm Control method of Multi-input Convolutional Neural Network ({FC}-{MCNN}) is proposed in this article. First, several classic Convolutional Neural Network ({CNN}) models are compared and analyzed. Then, a Multi-input Convolutional Neural Network ({MCNN}) is designed to extract more useful information from radar echo signal. Simultaneously, in order to improve the generalization performance of the model and control the false alarm probability, a controllable false alarm Support Vector Machine ({SVM}) is used to modify the final output module. In addition, the datasets are also preprocessed before being input into the proposed model. Finally, the performance of the proposed method is verified by the {IPIX} measured data sets. The results show that the proposed method has a higher detection probability and better computational performance than the traditional {CNN} detection methods.},
	pages = {15525--15534},
	journaltitle = {{IEEE} Access},
	author = {Sun, Qing and Zhao, Jing and Xue, Chunling and Yang, Xueting},
	date = {2024},
	keywords = {signal processing, Radar, Radar detection, Feature extraction, Object detection, Support vector machines, Convolutional neural networks, convolutional neural network ({CNN}), constant false alarm rate ({CFAR}), Sea measurements, Sea surface, support vector machine ({SVM}), Target detection},
}

@inproceedings{wang_air--ground_2023,
	title = {Air-to-Ground Abnormal Change Detection Method Based on Onboard {SLAM}},
	doi = {10.1109/ICUS58632.2023.10318407},
	abstract = {The abnormal change detection method based on {SLAM} (Simultaneous Localization And Mapping) has important significance in realtime monitoring, rapid detection, providing environmental intelligence, and automation applications, and can be widely applied in fields such as military, security, environmental monitoring, and disaster management. This method utilizing the laser radar carried by {UAV} (Unmanned Aerial Vehicle) for point cloud mapping and detects changes in the environment by comparing the mapping results at different time periods. This article builds environmental scenarios by using a systematic simulation platform and verifying experimental results. {ALOAM} (Lidar Odometry And Mapping) algorithm is selected as the 3D {SLAM} {LiDAR} map construction algorithm. When the contrast anomaly rate of the mapping results exceeds the threshold, the {UAV} will combine {YOLO}-V4 object detection technology to identify the abnormal targets in the environment and provide strong support and reference for decision-makers in various fields.},
	pages = {957--961},
