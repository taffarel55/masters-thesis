@article{pang_one-stage_2025,
	title = {A One-stage {HMDV} Algorithm Applied in {MultiTarget} Detection in {SAR} Images},
	issn = {19391404},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105009870224&doi=10.1109%2fJSTARS.2025.3585103&partnerID=40&md5=a25fc557278aab3c4c74bde155b84b09},
	doi = {10.1109/JSTARS.2025.3585103},
	abstract = {{SAR} image target detection is a key method in image interpretation. Currently, most radar target detection methods are primarily designed for single category, without adequately addressing the challenges of multi-target detection accuracy and lightweight deployment in coastal areas. To tackle these issues, this paper proposes a single-stage multi-target detection network called {HMDV}. First, a hybrid feature extraction module ({HFEBlock}) is designed to address the computational complexity caused by increased width and depth in convolutional neural networks. Second, to overcome the challenges posed by the diversity of target sizes in multi-target detection, the loss of dense target feature information, and background clutter, a multi-dimensional perceptual feature aggregation module ({MP}-{FADM}) are developed. This module effectively improves the detection accuracy for aircraft and oil tank targets in {SAR} images. Finally, to resolve the issue of low detection performance due to the small proportion of small targets in the prediction boxes, a new width and height vector loss function ({WHVIoU}) is proposed. This function simultaneously constrains the width, height, and proportion of bounding boxes, enhancing the network's convergence speed and reducing misdetections of small-sized ships. Experimental results demonstrate that the proposed model improves {mAP} accuracy by 2.4\% and reduces the number of parameters to 13\% of the original, confirming the model's effectiveness and robustness © 2008-2012 {IEEE}.},
	journaltitle = {{IEEE} Journal of Selected Topics in Applied Earth Observations and Remote Sensing},
	author = {Pang, Lei and Huang, Weihe and Zhang, Fengli and Song, Yinhong},
	date = {2025},
	note = {Publisher: Institute of Electrical and Electronics Engineers Inc.
Type: Article},
	keywords = {Synthetic aperture radar, Accuracy, Deep learning, Feature extraction, Object detection, Convolution, Radar polarimetry, Signal detection, Radar imaging, Convolutional neural networks, synthetic aperture radar ({SAR}), Aircraft detection, Marine vehicles, Bridges, multi-target detection, Prediction algorithms, width and height vector loss function ({WHVIoU}), Coastal area, Detection accuracy, Detection methods, Image enhancement, Image interpretation, Multi-target detection, Radar target detection, Radar target recognition, {SAR} Images, Targets detection, Tracking radar, {WHVIoU}},
