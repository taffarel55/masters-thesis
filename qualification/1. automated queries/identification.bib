@article{wang_reliable_2025,
	title = {Reliable Collision Avoidance for Small {UAVs} via Deep Reinforcement Learning with Unified Data Representation},
	issn = {23013850},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105010408802&doi=10.1142%2fS2301385026500500&partnerID=40&md5=d045f59ab0cd7c0e2ba2e25870099a32},
	doi = {10.1142/S2301385026500500},
	abstract = {Collision avoidance is a fundamental capability for multi-{UAV} systems to complete autonomous tasks. For small rotary-wing {UAVs}, due to their limited perception capacities and flight endurance, achieving reliable collision avoidance remains challenging. To this end, we propose a reliable multi-{UAV} collision avoidance method based on deep reinforcement learning, which leverages information from neighboring {UAVs} to augment the onboard perception capabilities. This method utilizes a technique called unified data representation ({UDR}) to combine depth data from {LiDAR} measurements and information from neighboring {UAVs} into a compact feature embedding, which can effectively integrate various observations with significant dimensional differences and inconsistent environmental expressions. Based on this, the collision avoidance policy hosted by a neural network is learned and produces control references for each {UAV} to ensure safety during flight. The training experiments demonstrate that our method achieves approximately a 20\% improvement in average rewards compared to baseline approaches, using the same number of training episodes. Additionally, we perform validation experiments using the {PX}4 flight controller in a soft-in-the-loop ({SITL}) setup within the Gazebo simulator. Experimental results show that our approach significantly improves the reliability of collision avoidance, particularly in scenarios involving inter-aircraft collisions. © 2026 World Scientific Publishing Company.},
	journaltitle = {Unmanned Systems},
	author = {Wang, Guanzheng and Wang, Xiangke and Liu, Zhihong and Liu, Yunhao and Li, Xiaoxin},
