@article{matthews_heterogeneous_2016,
	title = {Heterogeneous Convective Weather Forecast Translation into Airspace Permeability with Prediction Intervals},
	volume = {24},
	url = {https://doi.org/10.2514/1.D0025},
	doi = {10.2514/1.D0025},
	abstract = {The translation of convective weather information into capacity metrics such as airspace permeability or flow rate is important for more effective air traffic management. Also important is understanding and conveying the uncertainty in future convective weather forecasts. Although some prior methods compute a confidence score, they do not translate the varying skills of different forecasts directly into uncertainty in the capacity metric itself. This paper describes a supervised machine learning approach leveraging multiple heterogeneous weather sources to forecast permeability, including prediction intervals to help guide the selection of appropriate traffic management initiatives. Computed permeability metrics are compared to observed traffic flow rates in 57 regions in the United States over 122 case days, and they are found to correlate well in high-demand airspace. The flight-path length through the impacted region, which is a partial surrogate for workload, also correlates well with permeability. Features from single and ensemble storm-resolving forecasts combined with two different probabilistic forecasts are used to generate 0–12 h estimates of airspace permeability including prediction intervals. The skills of the combined forecast and each contributing forecast are quantified across varying forecast horizons. The algorithms are implemented in a real-time decision-support system that was evaluated at several facilities in 2014 and 2015.},
	pages = {41--54},
	number = {2},
	journaltitle = {Journal of Air Transportation},
	author = {Matthews, Michael P. and Veillette, Mark S. and Venuti, Joseph C. and {DeLaura}, Richard A. and Kuchar, James K.},
	date = {2016},
	note = {\_eprint: https://doi.org/10.2514/1.D0025},
}

@inproceedings{puharic_predicting_2025,
	title = {Predicting {UAV} Class and Operating Mode using Machine Learning},
	doi = {10.1109/SysCon64521.2025.11014842},
	abstract = {Unmanned Aerial Vehicles ({UAVs}) present a growing threat in conflict zones worldwide. While various capabilities exist to neutralize {UAVs}, counter-{UAV} (C-{UAV}) operators face significant challenges in quickly and accurately characterizing aircraft beyond line-of-sight. This research aims to address these challenges by developing machine learning ({ML}) models trained on radar-derived air track data. Exploratory data analysis is applied to radar output to illuminate relationships between air track features and {UAV} class and operating mode. Key features include radar cross section ({RCS}), target length, altitude, speed, pitch, and heading. A recommended modeling pipeline is presented to demonstrate the flow of data from radar output to classification. By applying supervised {ML} time-series models, aircraft types and operating modes are classified on simulated data and validated on data from real aircraft. Using long-shortterm memory ({LSTM}) networks on simulated flight tracks, the model is able to achieve 98\% accuracy when classifying {UAV} class and 97\% accuracy when classifying operating mode. The model was validated on data from actual radar systems that predicted {UAV} class with 72\% accuracy, however, limited data available for certain classes of {UAVs} hindered the model's performance. This study lays the groundwork for future validation of these algorithms using radar track data from real-world {UAV} flight paths. In application, these models may provide decision aids to help C-{UAV} operators neutralize threats with speed and confidence.},
	pages = {1--8},
	booktitle = {2025 {IEEE} International systems Conference ({SysCon})},
	author = {Puharic, Grant and Frattini, Andrew and Haynes, Morgan and Adesagba, Samuel and Schmedeman, Phillip},
	date = {2025-04},
	note = {{ISSN}: 2472-9647},
	keywords = {Machine learning, Radar, Radar tracking, Accuracy, Aircraft, Atmospheric modeling, Automated Decision Aids, Autonomous aerial vehicles, Data models, Drone, Machine Learning, Predictive models, Radar cross-sections, Time Series Classification, Unmanned Aerial Vehicle},
}

@article{safa_low-complexity_2021,
	title = {A Low-Complexity Radar Detector Outperforming {OS}-{CFAR} for Indoor Drone Obstacle Avoidance},
	volume = {14},
	issn = {2151-1535},
	doi = {10.1109/JSTARS.2021.3107686},
	abstract = {As radar sensors are being miniaturized, there is a growing interest for using them in indoor sensing applications such as indoor drone obstacle avoidance. In those novel scenarios, radars must perform well in dense scenes with a large number of neighboring scatterers. Central to radar performance is the detection algorithm used to separate targets from the background noise and clutter. Traditionally, most radar systems use conventional constant false alarm rate ({CFAR}) detectors but their performance degrades in indoor scenarios with many reflectors. Inspired by the advances in nonlinear target detection, In this article, we propose a novel high performance, yet low-complexity target detector and we experimentally validate our algorithm on a dataset acquired using a radar mounted on a drone. We experimentally show that our proposed algorithm drastically outperforms ordered statistics {CFAR} ({OS}-{CFAR}) (standard detector used in automotive systems) for our specific task of indoor drone navigation with more than 19\% higher probability of detection for a given probability of false alarm. We also benchmark our proposed detector against a number of recently proposed multitarget {CFAR} detectors and show an improvement of 16\% in probability of detection compared to censored harmonic averaging {CFAR}, with even larger improvements compared to both outlier-robust {CFAR} and truncated statistics log-normal {CFAR} in our particular indoor scenario. To the best of authors’ knowledge, this article improves the state-of-the-art for high-performance yet low-complexity radar detection in critical indoor sensing applications.},
	pages = {9162--9175},
	journaltitle = {{IEEE} Journal of Selected Topics in Applied Earth Observations and Remote Sensing},
	author = {Safa, Ali and Verbelen, Tim and Keuninckx, Lars and Ocket, Ilja and Hartmann, Mathias and Bourdoux, André and Catthoor, Francky and Gielen, Georges G. E.},
	date = {2021},
	keywords = {Radar, Radar detection, Airborne radar, Constant false alarm rate ({CFAR}), Detectors, drone navigation, Drones, indoor drone obstacle avoidance, indoor radar sensing, Radar antennas, radar target detection, Sensors},
}

@inproceedings{alkharji_deep_2024,
	title = {Deep Learning Algorithms in Aircraft Detection and Classification: An Analytical Survey},
	doi = {10.1109/DeSE63988.2024.10912016},
	abstract = {Aircraft detection has become a very crucial aspect in the aviation industry due to its vital role in identifying unauthorized aircraft trespassing into restricted areas. Due to their significant role in decision-making, these detection systems must have a high level of accuracy. In this paper, we address deep learning feature extraction and aircraft detection methods. This study aims to explore deep learning-based feature extraction techniques and airplane identification techniques. The applications examined stop unauthorized aircraft from entering restricted airspace by utilizing a range of deep learning models. The study results and basic information on feature types, image types, and detection techniques are presented in this paper.},
