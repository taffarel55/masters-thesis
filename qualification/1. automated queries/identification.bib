@inproceedings{jacionis_change_2024,
	title = {Change in the Spectrum of {EM} Radiation of the Electric Propulsion System of a {UAV} under Conditions of Forced Flight Stabilization},
	isbn = {979-8-3315-2776-1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85199569626&doi=10.1109%2fAIEEE62837.2024.10586623&partnerID=40&md5=16bb421769acc79a09aa6a46ca04d772},
	doi = {10.1109/AIEEE62837.2024.10586623},
	abstract = {In the presence of new warfare technologies based on unmanned aerial vehicles ({UAVs}) or drones as a new type of mass production threats, today it is crucial to develop systems capable of detecting and defending people from the harmful objects flying high in the skies. Nowadays most drone detection methods are based on drone communication frequency recognition, thermal, audio signature detection or active radar technologies. Active radar technologies are easily detected due to their electromagnetic ({EM}) radiation and are one of the first to be destroyed or overflown. In the nearest future artificial intelligence instruments will be capable of performing full flight control and navigation without the need of any active radio communication {EM} radiation. This leaves us with very few technologies capable to detect drones in complete radio silence with no radio communication {EM} radiation on board. This paper presents a novel approach to the electrically powered drone detection techniques, where an electric propulsion system is an unavoidable drone design element. Our findings reveal significant variations in the {EM} radiation patterns across different types of drone electric propulsion engines and operational conditions. The paper presents the analysis of electric propulsion system structures installed in most common serial production drones, their propulsion engine control elements, sources of {EM} radiation and investigation of its frequency spectrum {EM} signature of a multirotor propulsion engines at various flight conditions and object drop tests performed. The change of the {EM} signature of drone dropping the object is presented as a key idea for safety system development to be used in the battlefield safety solutions. © 2024 {IEEE}.},
	booktitle = {Advances in Information, Electronic and Electrical Engineering - Proceedings of the 11th {IEEE} Workshop, {AIEEE} 2024},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Jacionis, Tomas and Urbanavicius, Vytautas},
	editor = {A, Romanovs and D, Navakauskas and M, Narigina},
	date = {2024},
	note = {Type: Conference paper},
	keywords = {Drone detection, Drones, Aircraft detection, Aerial vehicle, Antennas, Unmanned aerial vehicle, Condition, Electric propulsion systems, Electromagnetic signatures, Engines, Propulsion engine, Radar technology, Radio communication, Radio navigation, Spectra's, Technology-based},
	annotation = {Cited by: 0; Conference name: 11th {IEEE} Workshop on Advances in Information, Electronic and Electrical Engineering, {AIEEE} 2024; Conference date: 31 May 2024 through 1 June 2024; Conference code: 200961},
}

@article{xue_drone_2022,
	title = {Drone Identification Method Based on Mixed Domain Attention Mechanism; [采用混合域注意力机制的无人机识别方法]},
	volume = {56},
	issn = {0253987X},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85141369055&doi=10.7652%2fxjtuxb202210014&partnerID=40&md5=0a3a36f9a9690b55c8da465ae198295d},
	doi = {10.7652/xjtuxb202210014},
	abstract = {An economical, convenient and undisturbed drone detection method using sound and multiscale group convolution network with attention mechanism in mixed domain of channel space ({ECSANet}) is proposed in the context of susceptibility to electronic interference in identification of drones by radar and radio, and the interference of light and obstruction in identification of drones by images in public environments such as urban parks, squares and large amusement parks. Firstly, nine kinds of sound dataset of civil drones are established, and their logarithmic Mel spectra and dynamic characteristics are extracted. Secondly, based on packet convolution, channel shuffling and residual structure, a multi-scale group convolution network with channel shuffle ({MSSGNet}) is designed to reduce the network parameters and avoid over fitting. Then, the efficient channel and spatial attention ({ECSA}) is designed to extract more and more effective features of drone sounds. Finally, the {ECSA} is inserted into the {MSSGNet} to form an improved multiscale group convolution network with attention mechanism in mixed domain of channel space ({ECSANet}), offering a new method for sound recognition of drones. The designed {ECSANet} is used to identify the self-built civil drone sound dataset and environmental sound dataset urbansound8k. The results reveal that when compared with benchmark networks such as {ResNetl} 8, {ResNet}34, {ResNeXt}18, and {MobileNetV}2, the {MSSGNet} has fewer network parameters but a higher identification accuracy (up to 95. 1\%). The {ECSA} can be inserted into a variety of networks to improve identification accuracy of network models without introducing too many parameters, and it works well for sound classification tasks like drones. As compared with the {MSSGNet}, the improved {ECSANet} has an identification accuracy of 95. 9 \%, an increase of 0. 8 percent, demonstrating the superiority and feasibility in identifying a small sample of drones. © 2022 Xi'an Jiaotong University. All rights reserved.},
	pages = {141 -- 150},
