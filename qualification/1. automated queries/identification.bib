Type: Article},
	keywords = {Transfer learning, Synthetic aperture radar, machine learning, Aircraft detection, Radar target recognition, Targets detection, detection method, Objects detection, radar imagery, synthetic aperture radar, Training aircraft, Adversarial machine learning, Contrastive Learning, Dynamic aggregation, Dynamic semantic, Dynamic semantic guidance, Few-shot target detection, Global feature, Metalearning, semantic standardization, training, Zero-shot learning},
