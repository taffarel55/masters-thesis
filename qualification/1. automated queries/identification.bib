	url = {https://doi.org/10.1145/3631726.3631746},
	doi = {10.1145/3631726.3631746},
	series = {{WUWNet} '23},
	abstract = {In this paper, a {UUVs} dynamic detection method based on conflict search is proposed to solve the problem of path planning and conflict avoidance among multiple vehicles in underwater environment from time dimension. Based on the principle of conflict detection and resolution, the algorithm identifies potential conflict situations by analyzing and comparing the trajectories of {UUVs}, and adopts corresponding conflict resolution strategies to ensure the cooperative detection ability among {UUVs}. Experimental results show that this method can effectively plan the path of {UUVs} and make them complete the task of cooperative detection.},
