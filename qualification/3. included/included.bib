@inproceedings{zhang_research_2025,
	title = {Research on {Dynamic} {Obstacle} {Avoidance} and {Collaborative} {Control} for {Low}-{Altitude} {Aircraft} {Based} on {Deep} {Reinforcement} {Learning} and {Adaptive} {Signal} {Filtering}},
	doi = {10.1109/ICSP65755.2025.11086680},
	abstract = {This study integrates deep reinforcement learning (DRL) and adaptive signal filtering (ASF) to tackle dynamic obstacle avoidance and multi-UAV coordination in low-altitude scenarios. A GAN-VAE hybrid filter reduces LiDAR/radar noise by 37\%, enhancing sensor reliability. A lightweight DRL model (≤1M parameters) achieves 92\% obstacle avoidance success with ≤50ms latency via a safety-focused reward function. Federated learning cuts communication bandwidth by 25\%, while ST-GCN-based trajectory prediction limits conflicts to ≤5\%. Field tests validate {\textgreater}85\% task success and ≤100ms latency in urban/canyon environments. This work advances UTM systems, enabling safe UAV deployments in logistics, disaster response, and urban air mobility.loyments in logistics, disaster response, and urban air mobility.},
	booktitle = {2025 10th {International} {Conference} on {Intelligent} {Computing} and {Signal} {Processing} ({ICSP})},
	author = {Zhang, Ning},
	month = may,
	year = {2025},
	keywords = {Autonomous aerial vehicles, Real-time systems, Noise, Collision avoidance, Deep reinforcement learning, Reliability, deep reinforcement learning, Disasters, dynamic obstacle avoidance, Filtering, Logistics, Low-Altitude UAVs, Urban air mobility},
	pages = {841--846},
}

@article{alghayadh_quantum_2024,
	title = {Quantum {Target} {Recognition} {Enhancement} {Algorithm} for {UAV} {Consumer} {Applications}},
	volume = {70},
	issn = {00983063},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85196118428&doi=10.1109%2FTCE.2024.3412968&partnerID=40&md5=d65c9a032f718af1848999f3abdee53c},
	doi = {10.1109/TCE.2024.3412968},
	abstract = {In UAV Consumer Applications, the challenges and methods of current unmanned aerial vehicle (UAV) radar detection technology are examined. The quantum multi-pattern recognition network model and algorithm are analyzed, and the Quantum Multi-Pattern Recognition Algorithm based on Phase Rotation (PRQMPRA) is proposed according to Grover's algorithm optimization theory. The issue in the Redundancy Quantum Multi-Pattern Recognition Algorithm (RQMPRA), where a decrease in the probability of successful search can be caused by two phase rotations of π each, is addressed by the optimization algorithm. The pattern recognition capabilities of Error Backpropagation Algorithm (EBPA), the Deep Autoencoder Learning Algorithm based on Cross-Entropy Function (CDAA), RQMPRA, and PRQMPRA are examined using three different datasets. The results indicate that a higher recognition rate and relatively faster processing speed are exhibited by PRQMPRA when error constraints are specified. To study the target detection problem in UAV consumer applications using a pattern classification approach, a radar target detection method based on the Quantum Multi-Pattern Recognition Algorithm is proposed. Experiments for UAV target detection is conducted with the four algorithms, and the research demonstrates that higher detection accuracy and a high discovery probability can be maintained in low signal-to-noise ratio conditions by PRQMPRA. © 2024 Elsevier B.V., All rights reserved.},
	language = {en-US},
	number = {3},
	journal = {IEEE Transactions on Consumer Electronics},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {AlGhayadh, Faisal Yousef and Ramesh, Janjhyam Venkata Naga and Keshta, Ismail Mohamed and Soni, Mukesh and Rivera, Richard and Prasad, K. D.V. and Soomar, Arsalan Muhammad and Tiwari, Mohit},
	year = {2024},
	note = {Type: Article},
	keywords = {Radar detection, Deep learning, Object detection, Signal detection, Target recognition, Aircraft detection, Signal to noise ratio, Optimization, Targets detection, Tracking radar, Unmanned aerial vehicles (UAV), Aerial vehicle, Antennas, Objects detection, Quantum Computing, Unmanned aerial vehicle, Computation theory, Multi patterns, Pattern recognition algorithms, Quantum computers, Site selection},
	pages = {5553 -- 5560},
}
